{
  "name": "platom",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "www": "node -e \"const fs=require('fs');fs.rmSync('www',{recursive:true,force:true});fs.mkdirSync('www');for(const f of ['index.html','config.js','manifest.webmanifest','icon.svg','privacy.html','sw.js'])fs.copyFileSync(f,'www/'+f)\"",
    "android": "npm run www && npx cap sync android && npx cap open android",
    "ios": "npm run www && npx cap sync ios && npx cap open ios"
  },
  "dependencies": { "@capacitor/core": "^6.0.0", "@capacitor/android": "^6.0.0", "@capacitor/ios": "^6.0.0" },
  "devDependencies": { "@capacitor/cli": "^6.0.0" }
}
